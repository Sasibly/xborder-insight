# 运行模式: mock | live
# mock 不调用任何外部服务, 可在完全离线状态下跑通全链路
RUN_MODE=mock

# LLM 供应商 (DashScope 百炼, OpenAI 兼容协议)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embedding: hash | dashscope
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=512

# 聚类阈值 (余弦相似度), 越高主题越细。
#
# 默认值按 EMBEDDING_PROVIDER 取标定结果，不要在这里抄一个数字——阈值是向量的属性，
# 不是全局常量：同一个 0.28 在 hash 下和 dashscope 下意味着完全不同的分区。
#   命中标定平台区的值：hash 0.12 / dashscope 0.65
# 标定依据（51 条 evidence、120 对人工标注、ARI + pairwise F1、阈值扫描曲线）：
#   docs/05-聚类阈值标定.md
#
# 两个后端的实测相似度分布差异，能说明为什么不能共用一个值：
#   hash      同主题对 P50 0.147 / 不同主题对 P50 0.160  ← 不同主题反而更相似
#   dashscope 同主题对 P50 0.712 / 不同主题对 P50 0.675  ← 有区分度，重叠区在 0.60~0.70
#
# 只有做对照实验或临时降级时才显式设置；一旦设置，/ready 会回显 source=env。
# CLUSTER_SIMILARITY_THRESHOLD=0.65

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 数据库 (SQLite; 换 PG 只需替换 db/connection.py 的 connect 实现)
DB_PATH=data/app.sqlite3

# 默认贸易术语 (EXW | FOB | CFR | CIF | DAP | DDP)
# 建站初期统一按 FOB：报价视为不含头程与关税。
# 该值只在调用方未指定时生效，且响应会回显 incoterm_assumed=true 以示区别。
DEFAULT_INCOTERM=FOB

# 任务执行器 (POST /v1/jobs)
# 关掉后仍可提交任务，但需要外部进程跑 scripts/jobs.py drain 才会执行——
# 排查「任务不跑」时先看这一项。
JOB_WORKER_ENABLED=true
# 租约秒数：worker 领任务后必须在此时间内完成，否则视为崩溃可被回收。
# 执行期间有心跳续租，所以这里填的是「心跳中断多久算死」，不是任务总时长上限。
JOB_LEASE_SECONDS=120
# 自动重试上限 (1..10)，与数据库 CHECK 约束保持一致
JOB_MAX_ATTEMPTS=3
# 进程内并发任务数
JOB_CONCURRENCY=2
# 队列为空时的轮询间隔（秒）
JOB_POLL_SECONDS=0.5

# 接入控制 (POST /v1/jobs 等)
# 鉴权默认跟随运行模式：mock 下关闭（本地跑通零摩擦），live 下强制开启。
# 想显式覆盖就写 true/false。关闭时启动日志会打印 auth.disabled，
# /ready 也会回报 auth=disabled——「忘了开鉴权」不会有任何报错，只能靠这两处暴露。
# AUTH_REQUIRED=true
#
# 同步分析接口不落 jobs 台账，因此不受 token 配额约束。
# 默认 mock 下开、live 下关；生产环境请走 POST /v1/jobs。
# SYNC_ANALYZE_ENABLED=false
